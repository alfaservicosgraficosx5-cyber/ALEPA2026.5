rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPrimaryAdminEmail() {
      return isVerified()
        && request.auth.token.email is string
        && request.auth.token.email.lower() in [
          'saviobaia6@gmail.com',
          'saviobaiax5@gmail.com',
          'legcmp.dle@gmail.com',
          'alfaservicosgraficosx5@gmail.com'
        ];
    }

    function hasOwnUserProfile() {
      return isVerified() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function ownUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isVerified() && (
        isPrimaryAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (hasOwnUserProfile() && ownUserRole() in ['admin', 'dev'])
      );
    }

    function isEditor() {
      return isVerified() && (
        isAdmin() ||
        (hasOwnUserProfile() && ownUserRole() in ['editor', 'teacher'])
      );
    }

    function familyDocId() {
      return ('fam_' + request.auth.token.email.lower().replace('[^a-z0-9]', '_'));
    }

    function isFamilyPublisher() {
      return isVerified()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/familyMembers/$(familyDocId()))
        && get(/databases/$(database)/documents/familyMembers/$(familyDocId())).data.active == true
        && get(/databases/$(database)/documents/familyMembers/$(familyDocId())).data.canPublish == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'dailyGoalMinutes', 'examDate', 'targetCargo', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'role', 'dailyGoalMinutes', 'examDate', 'targetCargo', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 160))
        && data.role is string && data.role in ['student', 'editor', 'admin', 'dev', 'teacher']
        && data.dailyGoalMinutes is int && data.dailyGoalMinutes >= 15 && data.dailyGoalMinutes <= 720
        && data.examDate is string && data.examDate.size() >= 8 && data.examDate.size() <= 20
        && data.targetCargo is string && data.targetCargo.size() >= 1 && data.targetCargo.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTopicProgress(data, userId, topicId) {
      return data.keys().hasAll(['userId', 'topicId', 'disciplineId', 'theoryDone', 'questionsDone', 'revisionDone', 'masteryLevel', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'topicId', 'disciplineId', 'theoryDone', 'questionsDone', 'revisionDone', 'masteryLevel', 'notes', 'updatedAt'])
        && data.userId is string && data.userId == userId
        && data.topicId is string && data.topicId == topicId
        && data.disciplineId is string && data.disciplineId.size() >= 1 && data.disciplineId.size() <= 80
        && data.theoryDone is bool
        && data.questionsDone is bool
        && data.revisionDone is bool
        && data.masteryLevel is int && data.masteryLevel >= 0 && data.masteryLevel <= 100
        && (!data.keys().hasAny(['notes']) || (data.notes is string && data.notes.size() <= 2000))
        && data.updatedAt is timestamp;
    }

    function isValidStudySession(data, userId) {
      return data.keys().hasAll(['userId', 'dateKey', 'disciplineId', 'topicTitle', 'blockType', 'durationMinutes', 'createdAt'])
        && data.keys().hasOnly(['userId', 'dateKey', 'disciplineId', 'topicTitle', 'blockType', 'durationMinutes', 'notes', 'createdAt'])
        && data.userId is string && data.userId == userId
        && data.dateKey is string && data.dateKey.size() >= 8 && data.dateKey.size() <= 20
        && data.disciplineId is string && data.disciplineId.size() >= 1 && data.disciplineId.size() <= 80
        && data.topicTitle is string && data.topicTitle.size() >= 1 && data.topicTitle.size() <= 200
        && data.blockType is string && data.blockType in ['theory', 'questions', 'correction', 'revision']
        && data.durationMinutes is int && data.durationMinutes >= 1 && data.durationMinutes <= 600
        && (!data.keys().hasAny(['notes']) || (data.notes is string && data.notes.size() <= 1000))
        && data.createdAt is timestamp;
    }

    function isValidSimuladoAttempt(data, userId) {
      return data.keys().hasAll(['userId', 'title', 'mode', 'primaryDisciplineId', 'totalQuestions', 'correctCount', 'score', 'durationSeconds', 'createdAt'])
        && data.keys().hasOnly(['userId', 'title', 'mode', 'primaryDisciplineId', 'totalQuestions', 'correctCount', 'score', 'durationSeconds', 'createdAt'])
        && data.userId is string && data.userId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.mode is string && data.mode in ['treino', 'simulado']
        && data.primaryDisciplineId is string && data.primaryDisciplineId.size() >= 1 && data.primaryDisciplineId.size() <= 80
        && data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 200
        && data.correctCount is int && data.correctCount >= 0 && data.correctCount <= data.totalQuestions
        && (data.score is float || data.score is int) && data.score >= 0 && data.score <= 10
        && data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 36000
        && data.createdAt is timestamp;
    }

    function isValidErrorEntry(data, userId) {
      return data.keys().hasAll(['userId', 'questionId', 'disciplineId', 'topicTitle', 'questionStem', 'correctOption', 'selectedOption', 'errorReason', 'improvementNote', 'nextReviewDate', 'reviewCount', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'questionId', 'disciplineId', 'topicTitle', 'questionStem', 'correctOption', 'selectedOption', 'errorReason', 'improvementNote', 'nextReviewDate', 'reviewCount', 'status', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == userId
        && data.questionId is string && isValidId(data.questionId)
        && data.disciplineId is string && data.disciplineId.size() >= 1 && data.disciplineId.size() <= 80
        && data.topicTitle is string && data.topicTitle.size() >= 1 && data.topicTitle.size() <= 200
        && data.questionStem is string && data.questionStem.size() >= 1 && data.questionStem.size() <= 2000
        && data.correctOption is string && data.correctOption.size() >= 1 && data.correctOption.size() <= 500
        && data.selectedOption is string && data.selectedOption.size() >= 1 && data.selectedOption.size() <= 500
        && data.errorReason is string && data.errorReason in ['atencao', 'teoria', 'lei_seca', 'banca_cetap']
        && data.improvementNote is string && data.improvementNote.size() <= 2000
        && data.nextReviewDate is string && data.nextReviewDate.size() >= 8 && data.nextReviewDate.size() <= 20
        && data.reviewCount is int && data.reviewCount >= 0 && data.reviewCount <= 1000
        && data.status is string && data.status in ['pending', 'mastered']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDisciplineGoal(data, userId, disciplineId) {
      return data.keys().hasAll(['userId', 'disciplineId', 'weeklyGoalMinutes', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'disciplineId', 'weeklyGoalMinutes', 'updatedAt'])
        && data.userId is string && data.userId == userId
        && data.disciplineId is string && data.disciplineId == disciplineId && data.disciplineId.size() >= 1 && data.disciplineId.size() <= 80
        && data.weeklyGoalMinutes is int && data.weeklyGoalMinutes >= 15 && data.weeklyGoalMinutes <= 2520
        && data.updatedAt is timestamp;
    }

    function isValidMaterial(data) {
      return data.keys().hasAll(['ownerId', 'title', 'disciplineId', 'fileType', 'url', 'isShared', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerId', 'title', 'disciplineId', 'libraryCategoryId', 'editalTopic', 'resourceType',
          'fileType', 'institution', 'url', 'pricing', 'publishedAt', 'lastVerifiedAt',
          'linkStatus', 'isOfficialContent', 'relevanceTier', 'campusLevel', 'status', 'updatedBy',
          'fileName', 'description', 'isShared',
          'allowDownload', 'textLayerStatus', 'pageCount', 'fileSizeBytes', 'version', 'versionNote',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.disciplineId is string && data.disciplineId.size() >= 1 && data.disciplineId.size() <= 80
        && (!data.keys().hasAny(['libraryCategoryId']) || (data.libraryCategoryId is string && data.libraryCategoryId.size() >= 1 && data.libraryCategoryId.size() <= 80))
        && (!data.keys().hasAny(['editalTopic']) || (data.editalTopic is string && data.editalTopic.size() <= 240))
        && (!data.keys().hasAny(['resourceType']) || (data.resourceType is string && data.resourceType in ['pdf', 'livro_digital', 'video', 'podcast', 'legislacao', 'curso', 'questoes', 'simulado']))
        && data.fileType is string && data.fileType in ['pdf', 'pptx', 'xlsx', 'drive', 'video']
        && (!data.keys().hasAny(['institution']) || (data.institution is string && data.institution.size() <= 160))
        && data.url is string && data.url.size() >= 1 && data.url.size() <= 2000
        && (!data.keys().hasAny(['pricing']) || (data.pricing is string && data.pricing in ['gratuito', 'pago']))
        && (!data.keys().hasAny(['publishedAt']) || (data.publishedAt is string && data.publishedAt.size() <= 20))
        && (!data.keys().hasAny(['lastVerifiedAt']) || (data.lastVerifiedAt is string && data.lastVerifiedAt.size() <= 20))
        && (!data.keys().hasAny(['linkStatus']) || (data.linkStatus is string && data.linkStatus in ['ativo', 'instavel', 'atualizacao']))
        && (!data.keys().hasAny(['isOfficialContent']) || data.isOfficialContent is bool)
        && (!data.keys().hasAny(['relevanceTier']) || (data.relevanceTier is string && data.relevanceTier in ['essencial', 'complementar', 'aprofundamento']))
        && (!data.keys().hasAny(['campusLevel']) || (data.campusLevel is string && data.campusLevel in ['geral', 'superior', 'medio']))
        && (!data.keys().hasAny(['status']) || (data.status is string && data.status in ['draft', 'published', 'archived']))
        && (!data.keys().hasAny(['updatedBy']) || (data.updatedBy is string && data.updatedBy.size() <= 128))
        && (!data.keys().hasAny(['fileName']) || (data.fileName is string && data.fileName.size() <= 240))
        && (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 1000))
        && (!data.keys().hasAny(['allowDownload']) || data.allowDownload is bool)
        && (!data.keys().hasAny(['textLayerStatus']) || (data.textLayerStatus is string && data.textLayerStatus in ['selectable', 'scanned', 'mixed', 'unknown']))
        && (!data.keys().hasAny(['pageCount']) || (data.pageCount is int && data.pageCount >= 0 && data.pageCount <= 20000))
        && (!data.keys().hasAny(['fileSizeBytes']) || (data.fileSizeBytes is int && data.fileSizeBytes >= 0 && data.fileSizeBytes <= 500000000))
        && (!data.keys().hasAny(['version']) || (data.version is int && data.version >= 1 && data.version <= 1000))
        && (!data.keys().hasAny(['versionNote']) || (data.versionNote is string && data.versionNote.size() <= 300))
        && data.isShared is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReadingProgress(data, userId, materialId) {
      return data.keys().hasAll([
          'userId', 'materialId', 'materialTitle', 'lastPage', 'totalPages', 'progressPercent',
          'readingMode', 'fontSize', 'lineHeight', 'maxWidthCh', 'theme',
          'bookmarks', 'highlights', 'annotations', 'lastReadAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'materialId', 'materialTitle', 'lastPage', 'totalPages', 'progressPercent',
          'readingMode', 'fontSize', 'lineHeight', 'maxWidthCh', 'theme',
          'bookmarks', 'highlights', 'annotations', 'lastReadAt', 'updatedAt'
        ])
        && data.userId is string && data.userId == userId
        && data.materialId is string && data.materialId == materialId && isValidId(data.materialId)
        && data.materialTitle is string && data.materialTitle.size() >= 1 && data.materialTitle.size() <= 200
        && data.lastPage is int && data.lastPage >= 1 && data.lastPage <= 20000
        && data.totalPages is int && data.totalPages >= 1 && data.totalPages <= 20000
        && data.progressPercent is int && data.progressPercent >= 0 && data.progressPercent <= 100
        && data.readingMode is string && data.readingMode in ['book', 'reading', 'original']
        && data.fontSize is int && data.fontSize >= 12 && data.fontSize <= 32
        && (data.lineHeight is float || data.lineHeight is int) && data.lineHeight >= 1.1 && data.lineHeight <= 2.6
        && data.maxWidthCh is int && data.maxWidthCh >= 40 && data.maxWidthCh <= 110
        && data.theme is string && data.theme in ['paper', 'sepia', 'night']
        && data.bookmarks is list && data.bookmarks.size() <= 100 && (data.bookmarks.size() == 0 || data.bookmarks[0] is map)
        && data.highlights is list && data.highlights.size() <= 150 && (data.highlights.size() == 0 || data.highlights[0] is map)
        && data.annotations is list && data.annotations.size() <= 150 && (data.annotations.size() == 0 || data.annotations[0] is map)
        && data.lastReadAt is string && data.lastReadAt.size() >= 8 && data.lastReadAt.size() <= 40
        && data.updatedAt is timestamp;
    }

    function isValidSharedQuestion(data) {
      return data.keys().hasAll(['authorId', 'disciplineId', 'topicTitle', 'statement', 'options', 'correctIndex', 'explanation', 'isPublished', 'createdAt'])
        && data.keys().hasOnly([
          'authorId', 'disciplineId', 'topicTitle', 'statement', 'options', 'correctIndex',
          'explanation', 'legalBasis', 'source', 'originType', 'escolaridade', 'status',
          'isOfficial', 'isPublished', 'createdAt', 'updatedAt'
        ])
        && data.authorId is string && isValidId(data.authorId)
        && data.disciplineId is string && data.disciplineId.size() >= 1 && data.disciplineId.size() <= 80
        && data.topicTitle is string && data.topicTitle.size() >= 1 && data.topicTitle.size() <= 200
        && data.statement is string && data.statement.size() >= 5 && data.statement.size() <= 2500
        && data.options is list && data.options.size() == 5
        && data.options[0] is string && data.options[0].size() <= 500
        && data.options[1] is string && data.options[1].size() <= 500
        && data.options[2] is string && data.options[2].size() <= 500
        && data.options[3] is string && data.options[3].size() <= 500
        && data.options[4] is string && data.options[4].size() <= 500
        && data.correctIndex is int && data.correctIndex >= 0 && data.correctIndex <= 4
        && data.explanation is string && data.explanation.size() >= 1 && data.explanation.size() <= 2000
        && (!data.keys().hasAny(['legalBasis']) || (data.legalBasis is string && data.legalBasis.size() <= 400))
        && (!data.keys().hasAny(['source']) || (data.source is string && data.source.size() <= 160))
        && (!data.keys().hasAny(['originType']) || (data.originType is string && data.originType in ['official_cetap', 'official_camara', 'official_alepa', 'training_platform', 'ai_generated']))
        && (!data.keys().hasAny(['escolaridade']) || (data.escolaridade is string && data.escolaridade in ['superior', 'medio']))
        && (!data.keys().hasAny(['status']) || (data.status is string && data.status in ['draft', 'published', 'archived']))
        && (!data.keys().hasAny(['isOfficial']) || data.isOfficial is bool)
        && data.isPublished is bool
        && data.createdAt is timestamp
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp);
    }

    function isValidFamilyMember(data, memberId) {
      return data.keys().hasAll(['memberId', 'name', 'email', 'relationship', 'canPublish', 'active', 'invitedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['memberId', 'name', 'email', 'relationship', 'canPublish', 'active', 'invitedByUid', 'createdAt', 'updatedAt'])
        && data.memberId is string && data.memberId == memberId && isValidId(data.memberId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.relationship is string && data.relationship.size() >= 1 && data.relationship.size() <= 60
        && data.canPublish is bool
        && data.active is bool
        && data.invitedByUid is string && isValidId(data.invitedByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAccessSession(data) {
      return data.keys().hasAll(['userId', 'deviceId', 'displayName', 'accessType', 'deviceType', 'currentTab', 'activeCampus', 'isOnline', 'sessionStartedAt', 'lastSeenAt'])
        && data.keys().hasOnly(['userId', 'deviceId', 'displayName', 'accessType', 'deviceType', 'currentTab', 'activeCampus', 'isOnline', 'sessionStartedAt', 'lastSeenAt'])
        && data.userId is string && isValidId(data.userId)
        && data.deviceId is string && isValidId(data.deviceId) && data.deviceId.size() <= 80
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.accessType is string && data.accessType in ['admin', 'familiar', 'estudante']
        && data.deviceType is string && data.deviceType in ['mobile', 'desktop']
        && data.currentTab is string && data.currentTab.size() >= 1 && data.currentTab.size() <= 40
        && data.activeCampus is string && data.activeCampus in ['superior', 'medio']
        && data.isOnline is bool
        && data.sessionStartedAt is timestamp
        && data.lastSeenAt is timestamp;
    }

    function isValidManagedDiscipline(data, disciplineId) {
      return data.keys().hasAll(['id', 'name', 'shortName', 'campusLevel', 'editalBlock', 'priorityRank', 'examQuestions', 'examPoints', 'tieBreakerOrder', 'recommendedMinutesPerCycle', 'status', 'authorId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'shortName', 'campusLevel', 'editalBlock', 'priorityRank', 'examQuestions', 'examPoints', 'tieBreakerOrder', 'recommendedMinutesPerCycle', 'status', 'authorId', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == disciplineId && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.shortName is string && data.shortName.size() >= 1 && data.shortName.size() <= 60
        && data.campusLevel is string && data.campusLevel in ['superior', 'medio']
        && data.editalBlock is string && data.editalBlock in ['Conhecimentos Específicos', 'Legislação e Ética', 'Língua Portuguesa', 'Raciocínio Lógico', 'Noções de Informática']
        && data.priorityRank is int && data.priorityRank >= 1 && data.priorityRank <= 100
        && data.examQuestions is int && data.examQuestions >= 0 && data.examQuestions <= 200
        && (data.examPoints is float || data.examPoints is int) && data.examPoints >= 0 && data.examPoints <= 200
        && data.tieBreakerOrder is int && data.tieBreakerOrder >= 1 && data.tieBreakerOrder <= 100
        && data.recommendedMinutesPerCycle is int && data.recommendedMinutesPerCycle >= 10 && data.recommendedMinutesPerCycle <= 360
        && data.status is string && data.status in ['draft', 'published', 'archived']
        && data.authorId is string && isValidId(data.authorId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidManagedTopic(data, topicId) {
      return data.keys().hasAll(['topicId', 'disciplineId', 'campusLevel', 'title', 'subtopics', 'highYield', 'order', 'status', 'authorId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['topicId', 'disciplineId', 'campusLevel', 'title', 'subtopics', 'highYield', 'order', 'status', 'authorId', 'createdAt', 'updatedAt'])
        && data.topicId is string && data.topicId == topicId && isValidId(data.topicId)
        && data.disciplineId is string && data.disciplineId.size() >= 1 && data.disciplineId.size() <= 80
        && data.campusLevel is string && data.campusLevel in ['superior', 'medio']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 240
        && data.subtopics is list && data.subtopics.size() <= 30
        && data.highYield is bool
        && data.order is int && data.order >= 0 && data.order <= 500
        && data.status is string && data.status in ['draft', 'published', 'archived']
        && data.authorId is string && isValidId(data.authorId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSimuladoList(data, listId) {
      return data.keys().hasAll(['listId', 'title', 'campusLevel', 'durationMinutes', 'questionIds', 'status', 'authorId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['listId', 'title', 'description', 'campusLevel', 'durationMinutes', 'questionIds', 'status', 'authorId', 'createdAt', 'updatedAt'])
        && data.listId is string && data.listId == listId && isValidId(data.listId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 180
        && (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 800))
        && data.campusLevel is string && data.campusLevel in ['geral', 'superior', 'medio']
        && data.durationMinutes is int && data.durationMinutes >= 5 && data.durationMinutes <= 360
        && data.questionIds is list && data.questionIds.size() >= 1 && data.questionIds.size() <= 100
        && data.status is string && data.status in ['draft', 'published', 'archived']
        && data.authorId is string && isValidId(data.authorId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPlatformNotice(data, noticeId) {
      return data.keys().hasAll(['noticeId', 'title', 'body', 'campusLevel', 'priority', 'status', 'authorId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['noticeId', 'title', 'body', 'campusLevel', 'priority', 'eventDate', 'status', 'authorId', 'createdAt', 'updatedAt'])
        && data.noticeId is string && data.noticeId == noticeId && isValidId(data.noticeId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 180
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 2000
        && data.campusLevel is string && data.campusLevel in ['geral', 'superior', 'medio']
        && data.priority is string && data.priority in ['normal', 'importante', 'urgente']
        && (!data.keys().hasAny(['eventDate']) || (data.eventDate is string && data.eventDate.size() <= 20))
        && data.status is string && data.status in ['draft', 'published', 'archived']
        && data.authorId is string && isValidId(data.authorId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isOwner(adminId);
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isSignedIn()
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (incoming().role == 'student' || isAdmin());
      allow update: if isValidId(userId)
        && isSignedIn()
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'dailyGoalMinutes', 'examDate', 'targetCargo', 'updatedAt']))
        );

      match /topicProgress/{topicId} {
        allow get: if isValidId(userId) && isValidId(topicId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(userId) && isValidId(topicId)
          && isSignedIn()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidTopicProgress(incoming(), userId, topicId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(topicId)
          && isSignedIn()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidTopicProgress(incoming(), userId, topicId)
          && incoming().userId == existing().userId
          && incoming().topicId == existing().topicId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['theoryDone', 'questionsDone', 'revisionDone', 'masteryLevel', 'notes', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(topicId) && isSignedIn() && isOwner(userId);
      }

      match /studySessions/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(userId) && isValidId(sessionId)
          && isSignedIn()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidStudySession(incoming(), userId)
          && incoming().createdAt == request.time;
        allow delete: if isValidId(userId) && isValidId(sessionId) && isSignedIn() && isOwner(userId);
      }

      match /simuladoAttempts/{attemptId} {
        allow get: if isValidId(userId) && isValidId(attemptId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(userId) && isValidId(attemptId)
          && isSignedIn()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidSimuladoAttempt(incoming(), userId)
          && incoming().createdAt == request.time;
        allow delete: if isValidId(userId) && isValidId(attemptId) && isSignedIn() && isOwner(userId);
      }

      match /errorNotebook/{entryId} {
        allow get: if isValidId(userId) && isValidId(entryId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(userId) && isValidId(entryId)
          && isSignedIn()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidErrorEntry(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(entryId)
          && isSignedIn()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidErrorEntry(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().questionId == existing().questionId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (existing().status == 'pending' && incoming().diff(existing()).affectedKeys().hasOnly(['errorReason', 'improvementNote', 'nextReviewDate', 'reviewCount', 'status', 'updatedAt'])) ||
            (existing().status == 'mastered' && incoming().status == 'pending' && incoming().diff(existing()).affectedKeys().hasOnly(['errorReason', 'improvementNote', 'nextReviewDate', 'reviewCount', 'status', 'updatedAt']))
          );
        allow delete: if isValidId(userId) && isValidId(entryId) && isSignedIn() && isOwner(userId);
      }

      match /disciplineGoals/{disciplineId} {
        allow get: if isValidId(userId) && isValidId(disciplineId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(userId) && isValidId(disciplineId)
          && isSignedIn()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidDisciplineGoal(incoming(), userId, disciplineId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(disciplineId)
          && isSignedIn()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidDisciplineGoal(incoming(), userId, disciplineId)
          && incoming().userId == existing().userId
          && incoming().disciplineId == existing().disciplineId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['weeklyGoalMinutes', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(disciplineId) && isSignedIn() && isOwner(userId);
      }

      match /readingProgress/{materialId} {
        allow get: if isValidId(userId) && isValidId(materialId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(userId) && isValidId(materialId)
          && isSignedIn()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidReadingProgress(incoming(), userId, materialId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(materialId)
          && isSignedIn()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidReadingProgress(incoming(), userId, materialId)
          && incoming().userId == existing().userId
          && incoming().materialId == existing().materialId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'materialTitle', 'lastPage', 'totalPages', 'progressPercent', 'readingMode',
            'fontSize', 'lineHeight', 'maxWidthCh', 'theme',
            'bookmarks', 'highlights', 'annotations', 'lastReadAt', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(materialId) && isSignedIn() && isOwner(userId);
      }
    }

    match /materials/{materialId} {
      allow get: if isValidId(materialId) && (
        (existing().isShared == true && (!existing().keys().hasAny(['status']) || existing().status == 'published')) ||
        (isSignedIn() && (existing().ownerId == request.auth.uid || isEditor()))
      );
      allow list: if (resource.data.isShared == true && (!resource.data.keys().hasAny(['status']) || resource.data.status == 'published'))
        || (isSignedIn() && (resource.data.ownerId == request.auth.uid || isEditor()));
      allow create: if isValidId(materialId)
        && isSignedIn()
        && isValidMaterial(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isEditor() ||
          isFamilyPublisher() ||
          (incoming().isShared == false && (!incoming().keys().hasAny(['status']) || incoming().status == 'draft'))
        );
      allow update: if isValidId(materialId)
        && isSignedIn()
        && isValidMaterial(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isEditor() ||
          (isFamilyPublisher() && existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'disciplineId', 'libraryCategoryId', 'editalTopic', 'resourceType', 'fileType',
            'institution', 'url', 'pricing', 'publishedAt', 'lastVerifiedAt', 'linkStatus',
            'isOfficialContent', 'relevanceTier', 'campusLevel', 'status', 'updatedBy',
            'fileName', 'description', 'isShared',
            'allowDownload', 'textLayerStatus', 'pageCount', 'fileSizeBytes', 'version', 'versionNote',
            'updatedAt'
          ])) ||
          (existing().ownerId == request.auth.uid
            && incoming().isShared == existing().isShared
            && (!incoming().keys().hasAny(['status']) || incoming().status == 'draft')
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'disciplineId', 'libraryCategoryId', 'editalTopic', 'resourceType', 'fileType',
              'institution', 'url', 'pricing', 'publishedAt', 'lastVerifiedAt', 'linkStatus',
              'isOfficialContent', 'relevanceTier', 'campusLevel', 'fileName', 'description',
              'allowDownload', 'textLayerStatus', 'pageCount', 'fileSizeBytes', 'version', 'versionNote',
              'updatedAt'
            ]))
        );
      allow delete: if isValidId(materialId) && isSignedIn() && (existing().ownerId == request.auth.uid || isEditor());
    }

    match /sharedQuestions/{questionId} {
      allow get: if isValidId(questionId) && (
        (existing().isPublished == true && (!existing().keys().hasAny(['status']) || existing().status == 'published')) ||
        (isSignedIn() && (existing().authorId == request.auth.uid || isEditor()))
      );
      allow list: if (resource.data.isPublished == true && (!resource.data.keys().hasAny(['status']) || resource.data.status == 'published'))
        || (isSignedIn() && (resource.data.authorId == request.auth.uid || isEditor()));
      allow create: if isValidId(questionId)
        && isSignedIn()
        && isValidSharedQuestion(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && (
          isEditor() ||
          isFamilyPublisher() ||
          (incoming().isPublished == false && (!incoming().keys().hasAny(['status']) || incoming().status == 'draft'))
        );
      allow update: if isValidId(questionId)
        && isSignedIn()
        && isValidSharedQuestion(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && (
          isEditor() ||
          (existing().authorId == request.auth.uid
            && incoming().isPublished == existing().isPublished
            && (!incoming().keys().hasAny(['status']) || incoming().status == 'draft')
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'disciplineId', 'topicTitle', 'statement', 'options', 'correctIndex',
              'explanation', 'legalBasis', 'source', 'originType', 'escolaridade', 'isOfficial', 'updatedAt'
            ]))
        );
      allow delete: if isValidId(questionId) && isSignedIn() && (existing().authorId == request.auth.uid || isEditor());
    }

    match /familyMembers/{memberId} {
      allow get: if isValidId(memberId) && isSignedIn() && (
        isAdmin() ||
        (isVerified() && request.auth.token.email is string && memberId == familyDocId())
      );
      allow list: if isAdmin();
      allow create: if isValidId(memberId)
        && isAdmin()
        && isValidFamilyMember(incoming(), memberId)
        && incoming().invitedByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(memberId)
        && isAdmin()
        && isValidFamilyMember(incoming(), memberId)
        && incoming().memberId == existing().memberId
        && incoming().email == existing().email
        && incoming().invitedByUid == existing().invitedByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'relationship', 'canPublish', 'active', 'updatedAt']);
      allow delete: if isValidId(memberId) && isAdmin();
    }

    match /accessSessions/{sessionId} {
      allow get: if isValidId(sessionId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(sessionId)
        && isSignedIn()
        && isValidAccessSession(incoming())
        && incoming().userId == request.auth.uid
        && incoming().sessionStartedAt == request.time
        && incoming().lastSeenAt == request.time;
      allow update: if isValidId(sessionId)
        && isSignedIn()
        && isValidAccessSession(incoming())
        && incoming().userId == existing().userId
        && incoming().userId == request.auth.uid
        && incoming().deviceId == existing().deviceId
        && incoming().sessionStartedAt == existing().sessionStartedAt
        && incoming().lastSeenAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'accessType', 'deviceType', 'currentTab', 'activeCampus', 'isOnline', 'lastSeenAt']);
      allow delete: if isValidId(sessionId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /managedDisciplines/{disciplineId} {
      allow get: if isValidId(disciplineId) && (existing().status == 'published' || isEditor());
      allow list: if resource.data.status == 'published' || isEditor();
      allow create: if isValidId(disciplineId)
        && isEditor()
        && isValidManagedDiscipline(incoming(), disciplineId)
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(disciplineId)
        && isEditor()
        && isValidManagedDiscipline(incoming(), disciplineId)
        && incoming().id == existing().id
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'shortName', 'campusLevel', 'editalBlock', 'priorityRank',
          'examQuestions', 'examPoints', 'tieBreakerOrder', 'recommendedMinutesPerCycle',
          'status', 'updatedAt'
        ]);
      allow delete: if isValidId(disciplineId) && isAdmin();
    }

    match /managedTopics/{topicId} {
      allow get: if isValidId(topicId) && (existing().status == 'published' || isEditor());
      allow list: if resource.data.status == 'published' || isEditor();
      allow create: if isValidId(topicId)
        && isEditor()
        && isValidManagedTopic(incoming(), topicId)
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(topicId)
        && isEditor()
        && isValidManagedTopic(incoming(), topicId)
        && incoming().topicId == existing().topicId
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'disciplineId', 'campusLevel', 'title', 'subtopics', 'highYield', 'order', 'status', 'updatedAt'
        ]);
      allow delete: if isValidId(topicId) && isAdmin();
    }

    match /simuladoLists/{listId} {
      allow get: if isValidId(listId) && (existing().status == 'published' || isEditor());
      allow list: if resource.data.status == 'published' || isEditor();
      allow create: if isValidId(listId)
        && isEditor()
        && isValidSimuladoList(incoming(), listId)
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(listId)
        && isEditor()
        && isValidSimuladoList(incoming(), listId)
        && incoming().listId == existing().listId
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'description', 'campusLevel', 'durationMinutes', 'questionIds', 'status', 'updatedAt'
        ]);
      allow delete: if isValidId(listId) && isAdmin();
    }

    match /platformNotices/{noticeId} {
      allow get: if isValidId(noticeId) && (existing().status == 'published' || isEditor());
      allow list: if resource.data.status == 'published' || isEditor();
      allow create: if isValidId(noticeId)
        && isEditor()
        && isValidPlatformNotice(incoming(), noticeId)
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(noticeId)
        && isEditor()
        && isValidPlatformNotice(incoming(), noticeId)
        && incoming().noticeId == existing().noticeId
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'body', 'campusLevel', 'priority', 'eventDate', 'status', 'updatedAt'
        ]);
      allow delete: if isValidId(noticeId) && isAdmin();
    }
  }
}
