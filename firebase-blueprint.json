{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil do estudante, editor, administrador ou desenvolvedor no Meu Campus ALEPA",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "maxLength": 160 },
        "role": { "type": "string", "enum": ["student", "editor", "admin", "dev", "teacher"] },
        "dailyGoalMinutes": { "type": "integer" },
        "examDate": { "type": "string", "maxLength": 20 },
        "targetCargo": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "dailyGoalMinutes", "examDate", "targetCargo", "createdAt", "updatedAt"]
    },
    "TopicProgress": {
      "title": "TopicProgress",
      "description": "Progresso por tópico do edital Cargo 03 PL.AL.102 e PL.AL.060",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "topicId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "disciplineId": { "type": "string", "maxLength": 80 },
        "theoryDone": { "type": "boolean" },
        "questionsDone": { "type": "boolean" },
        "revisionDone": { "type": "boolean" },
        "masteryLevel": { "type": "integer" },
        "notes": { "type": "string", "maxLength": 2000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "topicId", "disciplineId", "theoryDone", "questionsDone", "revisionDone", "masteryLevel", "updatedAt"]
    },
    "StudySession": {
      "title": "StudySession",
      "description": "Registro de sessão diária do cronograma",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "dateKey": { "type": "string", "maxLength": 20 },
        "disciplineId": { "type": "string", "maxLength": 80 },
        "topicTitle": { "type": "string", "maxLength": 200 },
        "blockType": { "type": "string", "enum": ["theory", "questions", "correction", "revision"] },
        "durationMinutes": { "type": "integer" },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "dateKey", "disciplineId", "topicTitle", "blockType", "durationMinutes", "createdAt"]
    },
    "SimuladoAttempt": {
      "title": "SimuladoAttempt",
      "description": "Histórico de simulados e treinos cronometrados CETAP",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 160 },
        "mode": { "type": "string", "enum": ["treino", "simulado"] },
        "primaryDisciplineId": { "type": "string", "maxLength": 80 },
        "totalQuestions": { "type": "integer" },
        "correctCount": { "type": "integer" },
        "score": { "type": "number" },
        "durationSeconds": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "mode", "primaryDisciplineId", "totalQuestions", "correctCount", "score", "durationSeconds", "createdAt"]
    },
    "ErrorEntry": {
      "title": "ErrorEntry",
      "description": "Entrada do Caderno de Erros e Banco de Melhoria",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "questionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "disciplineId": { "type": "string", "maxLength": 80 },
        "topicTitle": { "type": "string", "maxLength": 200 },
        "questionStem": { "type": "string", "maxLength": 2000 },
        "correctOption": { "type": "string", "maxLength": 500 },
        "selectedOption": { "type": "string", "maxLength": 500 },
        "errorReason": { "type": "string", "enum": ["atencao", "teoria", "lei_seca", "banca_cetap"] },
        "improvementNote": { "type": "string", "maxLength": 2000 },
        "nextReviewDate": { "type": "string", "maxLength": 20 },
        "reviewCount": { "type": "integer" },
        "status": { "type": "string", "enum": ["pending", "mastered"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "questionId", "disciplineId", "topicTitle", "questionStem", "correctOption", "selectedOption", "errorReason", "improvementNote", "nextReviewDate", "reviewCount", "status", "createdAt", "updatedAt"]
    },
    "StudyMaterial": {
      "title": "StudyMaterial",
      "description": "Materiais catalogados da biblioteca digital com ciclo rascunho/publicado/arquivado",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "disciplineId": { "type": "string", "maxLength": 80 },
        "libraryCategoryId": { "type": "string", "maxLength": 80 },
        "editalTopic": { "type": "string", "maxLength": 240 },
        "resourceType": { "type": "string", "enum": ["pdf", "livro_digital", "video", "podcast", "legislacao", "curso", "questoes", "simulado"] },
        "fileType": { "type": "string", "enum": ["pdf", "pptx", "xlsx", "drive", "video"] },
        "institution": { "type": "string", "maxLength": 160 },
        "url": { "type": "string", "maxLength": 2000 },
        "pricing": { "type": "string", "enum": ["gratuito", "pago"] },
        "publishedAt": { "type": "string", "maxLength": 20 },
        "lastVerifiedAt": { "type": "string", "maxLength": 20 },
        "linkStatus": { "type": "string", "enum": ["ativo", "instavel", "atualizacao"] },
        "isOfficialContent": { "type": "boolean" },
        "relevanceTier": { "type": "string", "enum": ["essencial", "complementar", "aprofundamento"] },
        "campusLevel": { "type": "string", "enum": ["geral", "superior", "medio"] },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "fileName": { "type": "string", "maxLength": 240 },
        "description": { "type": "string", "maxLength": 1000 },
        "isShared": { "type": "boolean" },
        "allowDownload": { "type": "boolean" },
        "textLayerStatus": { "type": "string", "enum": ["selectable", "scanned", "mixed", "unknown"] },
        "pageCount": { "type": "integer" },
        "fileSizeBytes": { "type": "integer" },
        "version": { "type": "integer" },
        "versionNote": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "title", "disciplineId", "fileType", "url", "isShared", "createdAt", "updatedAt"]
    },
    "SharedQuestion": {
      "title": "SharedQuestion",
      "description": "Questão cadastrada com ciclo de revisão e publicação",
      "type": "object",
      "properties": {
        "authorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "disciplineId": { "type": "string", "maxLength": 80 },
        "topicTitle": { "type": "string", "maxLength": 200 },
        "statement": { "type": "string", "minLength": 5, "maxLength": 2500 },
        "options": { "type": "array" },
        "correctIndex": { "type": "integer" },
        "explanation": { "type": "string", "maxLength": 2000 },
        "legalBasis": { "type": "string", "maxLength": 400 },
        "source": { "type": "string", "maxLength": 160 },
        "originType": { "type": "string", "enum": ["official_cetap", "official_camara", "official_alepa", "training_platform", "ai_generated"] },
        "escolaridade": { "type": "string", "enum": ["superior", "medio"] },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "isOfficial": { "type": "boolean" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "disciplineId", "topicTitle", "statement", "options", "correctIndex", "explanation", "isPublished", "createdAt"]
    },
    "DisciplineWeeklyGoal": {
      "title": "DisciplineWeeklyGoal",
      "description": "Meta semanal de minutos de estudo definida pelo usuário por disciplina",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "disciplineId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "weeklyGoalMinutes": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "disciplineId", "weeklyGoalMinutes", "updatedAt"]
    },
    "FamilyMember": {
      "title": "FamilyMember",
      "description": "Familiar autorizado para acessar e/ou publicar conteúdos de ensino",
      "type": "object",
      "properties": {
        "memberId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "relationship": { "type": "string", "minLength": 1, "maxLength": 60 },
        "canPublish": { "type": "boolean" },
        "active": { "type": "boolean" },
        "invitedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["memberId", "name", "email", "relationship", "canPublish", "active", "invitedByUid", "createdAt", "updatedAt"]
    },
    "AccessSession": {
      "title": "AccessSession",
      "description": "Presença ativa de acesso em tempo real (computador e celular)",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "accessType": { "type": "string", "enum": ["admin", "familiar", "estudante"] },
        "deviceType": { "type": "string", "enum": ["mobile", "desktop"] },
        "currentTab": { "type": "string", "minLength": 1, "maxLength": 40 },
        "activeCampus": { "type": "string", "enum": ["superior", "medio"] },
        "isOnline": { "type": "boolean" },
        "sessionStartedAt": { "type": "string", "format": "date-time" },
        "lastSeenAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "deviceId", "displayName", "accessType", "deviceType", "currentTab", "activeCampus", "isOnline", "sessionStartedAt", "lastSeenAt"]
    },
    "ManagedDiscipline": {
      "title": "ManagedDiscipline",
      "description": "Disciplina institucional gerenciada pelo ambiente administrativo",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "shortName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "campusLevel": { "type": "string", "enum": ["superior", "medio"] },
        "editalBlock": { "type": "string", "enum": ["Conhecimentos Específicos", "Legislação e Ética", "Língua Portuguesa", "Raciocínio Lógico", "Noções de Informática"] },
        "priorityRank": { "type": "integer" },
        "examQuestions": { "type": "integer" },
        "examPoints": { "type": "number" },
        "tieBreakerOrder": { "type": "integer" },
        "recommendedMinutesPerCycle": { "type": "integer" },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "authorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "shortName", "campusLevel", "editalBlock", "priorityRank", "examQuestions", "examPoints", "tieBreakerOrder", "recommendedMinutesPerCycle", "status", "authorId", "createdAt", "updatedAt"]
    },
    "ManagedTopic": {
      "title": "ManagedTopic",
      "description": "Tópico do edital cadastrado e publicado pelo administrador/editor",
      "type": "object",
      "properties": {
        "topicId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "disciplineId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "campusLevel": { "type": "string", "enum": ["superior", "medio"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "subtopics": { "type": "array" },
        "highYield": { "type": "boolean" },
        "order": { "type": "integer" },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "authorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["topicId", "disciplineId", "campusLevel", "title", "subtopics", "highYield", "order", "status", "authorId", "createdAt", "updatedAt"]
    },
    "SimuladoList": {
      "title": "SimuladoList",
      "description": "Caderno de simulado ou lista de exercícios organizada pelo administrador/editor",
      "type": "object",
      "properties": {
        "listId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "description": { "type": "string", "maxLength": 800 },
        "campusLevel": { "type": "string", "enum": ["geral", "superior", "medio"] },
        "durationMinutes": { "type": "integer" },
        "questionIds": { "type": "array" },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "authorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["listId", "title", "campusLevel", "durationMinutes", "questionIds", "status", "authorId", "createdAt", "updatedAt"]
    },
    "PlatformNotice": {
      "title": "PlatformNotice",
      "description": "Avisos institucionais e marcos de cronograma publicados na plataforma",
      "type": "object",
      "properties": {
        "noticeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "body": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "campusLevel": { "type": "string", "enum": ["geral", "superior", "medio"] },
        "priority": { "type": "string", "enum": ["normal", "importante", "urgente"] },
        "eventDate": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "authorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["noticeId", "title", "body", "campusLevel", "priority", "status", "authorId", "createdAt", "updatedAt"]
    },
    "ReadingProgress": {
      "title": "ReadingProgress",
      "description": "Histórico de leitura digital, marcadores, destaques e anotações sincronizadas por estudante e material",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "materialId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "materialTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "lastPage": { "type": "integer" },
        "totalPages": { "type": "integer" },
        "progressPercent": { "type": "integer" },
        "readingMode": { "type": "string", "enum": ["book", "reading", "original"] },
        "fontSize": { "type": "integer" },
        "lineHeight": { "type": "number" },
        "maxWidthCh": { "type": "integer" },
        "theme": { "type": "string", "enum": ["paper", "sepia", "night"] },
        "bookmarks": { "type": "array" },
        "highlights": { "type": "array" },
        "annotations": { "type": "array" },
        "lastReadAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "materialId",
        "materialTitle",
        "lastPage",
        "totalPages",
        "progressPercent",
        "readingMode",
        "fontSize",
        "lineHeight",
        "maxWidthCh",
        "theme",
        "bookmarks",
        "highlights",
        "annotations",
        "lastReadAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Perfis individuais dos usuários autenticados"
    },
    "/users/{userId}/topicProgress/{topicId}": {
      "schema": { "$ref": "#/entities/TopicProgress" },
      "description": "Checklist e domínio por tópico do edital por usuário"
    },
    "/users/{userId}/studySessions/{sessionId}": {
      "schema": { "$ref": "#/entities/StudySession" },
      "description": "Histórico de sessões diárias de estudo"
    },
    "/users/{userId}/simuladoAttempts/{attemptId}": {
      "schema": { "$ref": "#/entities/SimuladoAttempt" },
      "description": "Histórico de simulados e treinos por usuário"
    },
    "/users/{userId}/errorNotebook/{entryId}": {
      "schema": { "$ref": "#/entities/ErrorEntry" },
      "description": "Caderno de erros e revisões programadas"
    },
    "/users/{userId}/disciplineGoals/{disciplineId}": {
      "schema": { "$ref": "#/entities/DisciplineWeeklyGoal" },
      "description": "Metas semanais de minutos de estudo por disciplina por usuário"
    },
    "/users/{userId}/readingProgress/{materialId}": {
      "schema": { "$ref": "#/entities/ReadingProgress" },
      "description": "Progresso de leitura, marcadores, destaques e anotações do Book Reader por estudante"
    },
    "/materials/{materialId}": {
      "schema": { "$ref": "#/entities/StudyMaterial" },
      "description": "Biblioteca digital estruturada com ciclo de publicação"
    },
    "/sharedQuestions/{questionId}": {
      "schema": { "$ref": "#/entities/SharedQuestion" },
      "description": "Questões oficiais e de treinamento complementar cadastradas"
    },
    "/familyMembers/{memberId}": {
      "schema": { "$ref": "#/entities/FamilyMember" },
      "description": "Lista de familiares autorizados e permissões de publicação de ensino"
    },
    "/accessSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/AccessSession" },
      "description": "Sessões ativas de acesso em tempo real para saber quantas pessoas estão acessando"
    },
    "/managedDisciplines/{disciplineId}": {
      "schema": { "$ref": "#/entities/ManagedDiscipline" },
      "description": "Disciplinas institucionais gerenciadas por administradores e editores"
    },
    "/managedTopics/{topicId}": {
      "schema": { "$ref": "#/entities/ManagedTopic" },
      "description": "Assuntos e tópicos do edital gerenciados por administradores e editores"
    },
    "/simuladoLists/{listId}": {
      "schema": { "$ref": "#/entities/SimuladoList" },
      "description": "Listas de exercícios e simulados organizados por administradores e editores"
    },
    "/platformNotices/{noticeId}": {
      "schema": { "$ref": "#/entities/PlatformNotice" },
      "description": "Avisos e comunicados de cronograma publicados na plataforma"
    }
  }
}
