rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isPrimaryAdminEmail() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() in [
          'saviobaia6@gmail.com',
          'saviobaiax5@gmail.com',
          'legcmp.dle@gmail.com',
          'alfaservicosgraficosx5@gmail.com'
        ];
    }

    function isStaffPathOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Biblioteca institucional e arquivos administrativos (PDFs, áudios, vídeos, imagens até 100 MB)
    match /campus-materials/{uploaderUid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if (isPrimaryAdminEmail() || isStaffPathOwner(uploaderUid))
        && (request.resource == null || request.resource.size < 100 * 1024 * 1024);
    }

    // Materiais pessoais / cadernos do próprio usuário (até 50 MB)
    match /user-uploads/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isPrimaryAdminEmail());
      allow write: if isSignedIn() && request.auth.uid == userId
        && (request.resource == null || request.resource.size < 50 * 1024 * 1024);
    }

    // Bloqueio padrão para qualquer outro caminho
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
